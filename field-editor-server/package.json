{
  "name": "field-editor-server",
  "version": "0.1.0",
  "description": "tiddlywiki edition development helper",
  "main": "index.js",
  "scripts": {
    "watch": "node --watch-path=../../plugins/wikilabs/field-editor ../scripts/tw.js --core dev . --listen host=local.lan",
		"net": "node ../scripts/tw.js --core dev . --listen host=local.lan",

    "start": "node ../scripts/tw.js --core dev . --mcp listen readwrite sse label=field-editor-primary",
    "test": "echo ---- no tests atm ----",

    "server": "npm start",

    "build:github": "node ../scripts/tw.js --core release ../field-editor --build github",
    "build": "node ../scripts/tw.js --core release ../field-editor --build index",

    "prestage": "npm run build",
    "stage": "npm run build:github",

    "deploy": "echo # deploy is done with wikilabs.github.io repo!"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikilabs/plugins"
  },
  "keywords": [
    "tiddlywiki",
    "editor",
    "fields"
  ],
  "author": "Mario Pietsch",
  "license": "",
  "bugs": {
    "url": "https://github.com/wikilabs/plugins/issues"
  },
  "homepage": "https://wikilabs.github.io/editions/field-editor",
  "dependencies": {
  },
  "devDependencies": {
  }
}
