{
  "name": "ztests-server",
  "version": "0.1.0",
  "description": "tiddlywiki edition development helper",
  "main": "index.js",
  "scripts": {
    "start": "node ../scripts/tw.js --core dev . --mcp listen readwrite sse label=z-tests-primary",
    "test": "echo ---- no tests atm ----",

    "server": "npm start",

    "build:github": "node ../scripts/tw.js --core release ../ztests --build github",
    "build": "node ../scripts/tw.js --core release ../ztests --build index",

    "prestage": "npm run build",
    "stage": "npm run build:github",

    "deploy": "echo # deploy is done with wikilabs.github.io repo!"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikilabs/plugins"
  },
  "keywords": [
    "tiddlywiki",
    "paragraph",
    "styling",
    "custom markup"
  ],
