{
  "name": "palette-switcher-server",
  "version": "0.0.1",
  "description": "tiddlywiki edition development helper",
  "main": "index.js",
  "scripts": {
    "start": "node ../scripts/tw.js --core dev . --mcp listen readwrite sse label=palette-switcher-primary",
    "test": "echo ---- no tests atm ----",
