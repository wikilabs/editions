{
  "name": "bundler-server",
  "version": "0.1.0",
  "description": "tiddlywiki edition development helper",
  "main": "index.js",
  "scripts": {
    "watch": "node --watch-path=../../plugins/wikilabs/bundler ../scripts/tw.js --core dev . --listen host=local.lan",

    "start": "node ../scripts/tw.js --core dev . --mcp listen host=localhost label=mcp-bundler",

    "test": "echo ---- no tests atm ----",

    "server": "npm start",

    "build:github": "node ../scripts/tw.js --core release ../bundler --build github",
    "build": "node ../scripts/tw.js --core release ../bundler --build index",

    "prestage": "npm run build",
    "stage": "npm run build:github",
    "poststage": "powershell copy ./files/images/*.* ../../wikilabs.github.io/editions/bundler/files/images",

    "deploy": "echo # deploy is done with wikilabs.github.io repo!"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikilabs/plugins"
  },
  "keywords": [
    "tiddlywiki",
    "bundler",
    "plugin"
  ],
  "author": "Mario Pietsch",
  "license": "",
  "bugs": {
    "url": "https://github.com/wikilabs/plugins/issues"
  },
  "homepage": "https://wikilabs.github.io/editions/bundler",
  "dependencies": {
  },
  "devDependencies": {
  }
}
