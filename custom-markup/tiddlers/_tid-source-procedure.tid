\procedure .tid-source(title)
<pre class="cm-tid-source">title: <$text text=<<title>>/>
<$list filter="[<title>fields[]sort[]] -title -text -bag -revision -created -modified" variable="fld"><$text text=<<fld>>/>: <$view tiddler=<<title>> field=<<fld>>/>
</$list><$list filter="[<title>has[text]]">
<$view tiddler=<<title>> field="text"/></$list></pre>
\end
