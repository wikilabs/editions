{
  "name": "uni-link-server",
  "version": "0.2.0",
  "description": "tiddlywiki edition development helper",
  "main": "index.js",
  "scripts": {
    "net": "node ../scripts/tw.js --core dev . --listen host=local.lan",

    "start": "node ../scripts/tw.js --core dev . --mcp listen readwrite sse label=uni-link-primary",
    "test": "npm run watch",

    "server": "npm start",

    "build:github": "node ../scripts/tw.js --core release ../uni-link --build github",
    "build": "node ../scripts/tw.js --core release ../uni-link --build index",

    "prestage": "npm run build",
    "stage": "npm run build:github",

    "deploy": "echo # deploy is done with wikilabs.github.io repo!"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikilabs/plugins"
  },
  "keywords": [
    "tiddlywiki",
    "parser",
    "wikitext"
  ],
  "author": "Mario Pietsch",
  "license": "",
  "bugs": {
    "url": "https://github.com/wikilabs/plugins/issues"
  },
  "homepage": "https://wikilabs.github.io/editions/uni-link",
  "devDependencies": {
  }
}
