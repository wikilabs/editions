{
  "name": "wikilabs.github.io-server",
  "version": "0.2.0",
  "description": "Auto deploy this project",
  "main": "index.js",
  "scripts": {
    "start": "node ../scripts/tw.js --core dev . --mcp listen readwrite sse label=wikilabs-ghub.io-primary",
    "test": "echo ---- no tests atm ----",
    "server": "npm start",
    "build:all": "node bin/run-all.js build",
    "build:github": "node ../scripts/tw.js --core release ../../wikilabs.github.io --build github",
    "build": "node ../scripts/tw.js --core release ../../wikilabs.github.io --build index",
    "stage:all": "node bin/run-all.js stage",
    "stage": "npm run build:github",
    "predeploy": "npm run stage:all",
    "deploy": "echo # Congratulation: The project is deployed!"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikilabs/wikilabs.github.io"
  },
  "keywords": [
    "wikilabs",
    "homepage"
  ],
  "author": "Mario Pietsch",
  "license": "",
  "bugs": {
    "url": "https://github.com/wikilabs/wikilabs.github.io/issues"
  },
  "homepage": "https://wikilabs.github.io",
  "dependencies": {},
  "devDependencies": {
  }
}
