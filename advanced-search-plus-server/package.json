{
	"name": "advanced-search-plus-server",
	"version": "0.1.0",
	"description": "tiddlywiki edition development helper",
	"main": "index.js",
	"scripts": {
		"watch": "node --watch-path=../../plugins/wikilabs/advanced-search-plus ../scripts/tw.js --core dev . --listen host=local.lan",
		"net": "node ../scripts/tw.js --core dev . --listen host=local.lan",

		"start": "node ../scripts/tw.js --core dev . --mcp listen readwrite sse label=advanced-search-plus-primary",
		"test": "npm run watch",

		"server": "npm start",

		"build:github": "node ../scripts/tw.js --core release ../advanced-search-plus --build github",
		"build": "node ../scripts/tw.js --core release ../advanced-search-plus --build index",

		"prestage": "npm run build",
		"stage": "npm run build:github",

		"deploy": "echo # deploy is done with wikilabs.github.io repo!"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wikilabs/plugins"
	},
	"keywords": [
		"tiddlywiki",
		"search",
		"advanced",
		"plugin"
	],
	"author": "Mario Pietsch",
	"license": "",
	"bugs": {
		"url": "https://github.com/wikilabs/plugins/issues"
	},
	"homepage": "https://wikilabs.github.io/editions/advanced-search-plus",
	"dependencies": {
	},
	"devDependencies": {
	}
}
